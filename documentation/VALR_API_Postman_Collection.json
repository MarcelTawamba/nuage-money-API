            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currencies\": [\"USDT\", \"USDC\", \"ZAR\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/valr/balances",
